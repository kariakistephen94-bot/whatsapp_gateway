# Required: clients must send this as "Authorization: Bearer <key>" or "x-api-key: <key>"
API_KEY=6b17565b479cbc8ebda32a5d1e9e4508fc1fd55d2dd380fa

PORT=3000
# Bind to localhost by default. Put a TLS reverse proxy in front if exposing publicly.
HOST=127.0.0.1

# Where the WhatsApp session (your linked-device credentials) is stored. KEEP PRIVATE.
AUTH_DIR=./auth_state

# Optional: POST incoming messages to this URL
WEBHOOK_URL=

# Minimum delay between outgoing messages, in ms (helps avoid spam flags)
MIN_SEND_INTERVAL_MS=1500

LOG_LEVEL=info

# --- Delivery/read status forwarding (optional; off when STATUS_WEBHOOK_URL is empty) ---
# Receiving endpoint for message_status events. Must NOT be the same endpoint as WEBHOOK_URL.
STATUS_WEBHOOK_URL=
# Sent as the X-Helios-Gateway-Key header. Min 16 chars, must differ from API_KEY.
# Generate one with: openssl rand -hex 32
STATUS_WEBHOOK_SECRET=
# Where the durable outbox + message ledger live (contains phone numbers; created with 0600/0700 perms)
STATUS_DATA_DIR=./data
# Optional tuning (defaults shown)
# STATUS_WEBHOOK_TIMEOUT_MS=10000
# STATUS_MAX_ATTEMPTS=12
# STATUS_RETRY_BASE_MS=5000
# STATUS_RETRY_MAX_MS=900000
# STATUS_LEDGER_TTL_DAYS=30
